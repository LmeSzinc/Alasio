{
  "name": "alasio-frontend",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/sync-version.mjs && vite build && node scripts/csp/verify.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "version:check": "node scripts/sync-version.mjs --check",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "codegen": "tsx scripts/check-format.ts",
    "test": "vitest run",
    "smoke:csp": "node ../webapp/node_modules/electron/cli.js ../webapp/scripts/csp/browser-smoke.cjs --target frontend",
    "i18ngen": "tsx scripts/i18n/cli.ts",
    "fix:lucide": "tsx scripts/lucide-per-icon.ts src"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^3.0.12",
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@dnd-kit-svelte/core": "^0.0.11",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/culori": "^4.0.1",
    "@types/fs-extra": "^11.0.4",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "mode-watcher": "^1.1.0",
    "postcss": "^8.5.33",
    "postcss-media-minmax": "^5.0.0",
    "postcss-nesting": "^13.0.2",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
