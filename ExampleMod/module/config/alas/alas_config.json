{
  "card-Alas-Game": {
    "_info": {"group": "Game", "arg": "_info", "card": "card-Alas-Game"},
    "Game": {
      "PackageName": {
        "task": "Alas",
        "group": "Game",
        "arg": "PackageName",
        "dt": "select",
        "value": "auto",
        "option": ["auto"]
      },
      "ServerName": {
        "task": "Alas",
        "group": "Game",
        "arg": "ServerName",
        "dt": "secondary-select",
        "value": "disabled",
        "option_dict": {
          "none": ["disabled"],
          "cn_android": ["cn_android-0", "cn_android-1", "cn_android-2", "cn_android-3", "cn_android-4", "cn_android-5", "cn_android-6", "cn_android-7", "cn_android-8", "cn_android-9", "cn_android-10", "cn_android-11", "cn_android-12", "cn_android-13", "cn_android-14", "cn_android-15", "cn_android-16", "cn_android-17", "cn_android-18", "cn_android-19", "cn_android-20", "cn_android-21", "cn_android-22", "cn_android-23", "cn_android-24", "cn_android-25"],
          "cn_ios": ["cn_ios-0", "cn_ios-1", "cn_ios-2", "cn_ios-3", "cn_ios-4", "cn_ios-5", "cn_ios-6", "cn_ios-7", "cn_ios-8", "cn_ios-9", "cn_ios-10"],
          "cn_channel": ["cn_channel-0", "cn_channel-1", "cn_channel-2", "cn_channel-3", "cn_channel-4"],
          "en": ["en-0", "en-1", "en-2", "en-3", "en-4", "en-5"],
          "jp": ["jp-0", "jp-1", "jp-2", "jp-3", "jp-4", "jp-5", "jp-6", "jp-7", "jp-8", "jp-9", "jp-10", "jp-11", "jp-12", "jp-13", "jp-14", "jp-15", "jp-16", "jp-17"]
        }
      }
    }
  },
  "card-Alas-Emulator": {
    "_info": {"group": "Emulator", "arg": "_info", "card": "card-Alas-Emulator"},
    "Emulator": {
      "Serial": {
        "task": "Device",
        "group": "Emulator",
        "arg": "Serial",
        "dt": "input",
        "value": "auto"
      },
      "ScreenshotMethod": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ScreenshotMethod",
        "dt": "select",
        "value": "auto",
        "option": ["auto", "ADB", "ADB_nc", "uiautomator2", "aScreenCap", "aScreenCap_nc", "DroidCast", "DroidCast_raw", "nemu_ipc", "ldopengl"]
      },
      "ControlMethod": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ControlMethod",
        "dt": "select",
        "value": "MaaTouch",
        "option": ["ADB", "uiautomator2", "minitouch", "Hermit", "MaaTouch"]
      },
      "ScreenshotDedithering": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ScreenshotDedithering",
        "dt": "checkbox",
        "value": false
      },
      "AdbRestart": {
        "task": "Device",
        "group": "Emulator",
        "arg": "AdbRestart",
        "dt": "checkbox",
        "value": false
      }
    }
  },
  "card-Alas-EmulatorInfo": {
    "_info": {"group": "EmulatorInfo", "arg": "_info", "card": "card-Alas-EmulatorInfo"},
    "EmulatorInfo": {
      "Emulator": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Emulator",
        "dt": "select",
        "value": "auto",
        "option": ["auto", "NoxPlayer", "NoxPlayer64", "BlueStacks4", "BlueStacks5", "BlueStacks4HyperV", "BlueStacks5HyperV", "LDPlayer3", "LDPlayer4", "LDPlayer9", "MuMuPlayer", "MuMuPlayerX", "MuMuPlayer12", "MEmuPlayer"]
      },
      "Name": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Name",
        "dt": "textarea",
        "value": "",
        "layout": "vert"
      },
      "Path": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Path",
        "dt": "textarea",
        "value": "",
        "layout": "vert"
      }
    }
  },
  "card-Alas-Error": {
    "_info": {"group": "Error", "arg": "_info", "card": "card-Alas-Error"},
    "Error": {
      "HandleError": {
        "task": "Device",
        "group": "Error",
        "arg": "HandleError",
        "dt": "checkbox",
        "value": true
      },
      "SaveError": {
        "task": "Device",
        "group": "Error",
        "arg": "SaveError",
        "dt": "checkbox",
        "value": true
      },
      "OnePushConfig": {
        "task": "Device",
        "group": "Error",
        "arg": "OnePushConfig",
        "dt": "textarea",
        "value": "provider: null",
        "layout": "vert"
      },
      "ScreenshotLength": {
        "task": "Device",
        "group": "Error",
        "arg": "ScreenshotLength",
        "dt": "input-int",
        "value": 1
      }
    }
  },
  "card-Alas-Optimization": {
    "_info": {"group": "Optimization", "arg": "_info", "card": "card-Alas-Optimization"},
    "Optimization": {
      "ScreenshotInterval": {
        "task": "Device",
        "group": "Optimization",
        "arg": "ScreenshotInterval",
        "dt": "input-float",
        "value": 0.3
      },
      "CombatScreenshotInterval": {
        "task": "Device",
        "group": "Optimization",
        "arg": "CombatScreenshotInterval",
        "dt": "input-float",
        "value": 1.0
      },
      "TaskHoardingDuration": {
        "task": "Device",
        "group": "Optimization",
        "arg": "TaskHoardingDuration",
        "dt": "input-int",
        "value": 0
      },
      "WhenTaskQueueEmpty": {
        "task": "Device",
        "group": "Optimization",
        "arg": "WhenTaskQueueEmpty",
        "dt": "select",
        "value": "goto_main",
        "option": ["stay_there", "goto_main", "stop_game"]
      }
    }
  },
  "card-RestartDeviceDisplay-RestartDevice": {
    "_info": {"group": "RestartDevice", "arg": "_info", "card": "card-RestartDeviceDisplay-RestartDevice"},
    "Scheduler": {
      "Enable": {
        "task": "RestartDevice",
        "group": "Scheduler",
        "arg": "Enable",
        "cls": "SchedulerStatic",
        "i18ngroup": "SchedulerStatic",
        "dt": "static",
        "value": "enabled",
        "option": ["enabled"]
      },
      "NextRun": {
        "task": "RestartDevice",
        "group": "Scheduler",
        "arg": "NextRun",
        "cls": "SchedulerStatic",
        "dt": "datetime",
        "value": "2020-01-01T00:00:00Z"
      }
    }
  },
  "card-RestartGameDisplay-RestartGame": {
    "_info": {"group": "RestartGame", "arg": "_info", "card": "card-RestartGameDisplay-RestartGame"},
    "Scheduler": {
      "Enable": {
        "task": "RestartGame",
        "group": "Scheduler",
        "arg": "Enable",
        "cls": "SchedulerStatic",
        "i18ngroup": "SchedulerStatic",
        "dt": "static",
        "value": "enabled",
        "option": ["enabled"]
      },
      "NextRun": {
        "task": "RestartGame",
        "group": "Scheduler",
        "arg": "NextRun",
        "cls": "SchedulerStatic",
        "dt": "datetime",
        "value": "2020-01-01T00:00:00Z"
      }
    }
  }
}