# EditorConfig: https://editorconfig.org
# Keeps editor-created files consistent with the repository's gitattributes
# (`* text=auto eol=lf`) and the project formatters (ruff / prettier).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{js,ts,mjs,cjs,svelte,css,html,json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
