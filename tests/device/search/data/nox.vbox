<?xml version="1.0"?>
<!--
** DO NOT EDIT THIS FILE.
** If you make changes to this file while any VirtualBox related application
** is running, your changes will be overwritten later, without taking effect.
** Use VBoxManage or the VirtualBox Manager GUI to make changes.
**
** Captured from a real Nox installation and redacted: the machine UUID and
** the MAC addresses are replaced, the trailing empty adapters are trimmed.
** Everything else keeps the real shape of a Nox config file, including
** several forwardings on one NAT adapter of which only "port2" forwards the
** adb guest port 5555.
-->
<VirtualBox xmlns="http://www.virtualbox.org/" version="1.15-windows">
