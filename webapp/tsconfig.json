{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "vite/client", "$app/types"],
    "paths": {
      "$lib": ["./renderer/lib"],
      "$lib/*": ["./renderer/lib/*"],
      "$src": ["./renderer"],
      "$src/*": ["./renderer/*"],
      "$routes": ["./renderer/routes"],
      "$routes/*": ["./renderer/routes/*"],
      "$shared": ["./shared"],
      "$shared/*": ["./shared/*"]
    }
  },
  "include": [
    "main/**/*",
    "preload/**/*",
    "renderer/**/*",
    "shared/**/*",
    "*.ts",
    "vite.config.mts",
    "vitest.config.mts",
    "postcss.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
