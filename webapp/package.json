{
  "name": "alasio",
  "version": "2.0.7",
  "description": "Alasio Electron Application",
  "author": "LmeSzinc",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && vite build && tsx scripts/csp/verify.ts && tsx scripts/pack-asar.ts && tsx scripts/csp/verify-asar.ts",
    "package": "node scripts/sync-version.mjs && vite build && tsx scripts/csp/verify.ts && electron-builder && tsx scripts/electron-cleanup.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "version:check": "node scripts/sync-version.mjs --check",
    "codegen": "tsx scripts/check-format.ts",
    "test": "vitest run",
    "smoke:csp": "electron scripts/csp/browser-smoke.cjs --target renderer",
    "smoke:focus": "electron scripts/focus/browser-smoke.cjs",
    "i18ngen": "tsx scripts/i18n/cli.ts",
    "fix:lucide": "tsx scripts/lucide-per-icon.ts renderer"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.17",
    "@csstools/postcss-oklab-function": "^5.0.17",
    "@electron/asar": "^4.3.2",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/culori": "^4.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.6.6",
    "autoprefixer": "^10.7.0",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "culori": "^4.0.2",
    "electron": "22.3.27",
    "electron-builder": "^26.18.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "postcss": "^8.5.33",
    "postcss-media-minmax": "^5.0.0",
    "postcss-nesting": "^14.0.3",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-winstaller", "esbuild"]
  }
}
